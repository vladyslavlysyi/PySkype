# База даних PostgreSQL (Local або Supabase/Neon/Render)
DATABASE_URL="postgresql://user:password@localhost:5432/skype_clone?schema=public"

# Секретний ключ для підпису JWT токенів
# Згенеруйте його командою: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key"

# URL вашого сайту (важливо для CORS та Socket.io)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# (Опціонально) TURN-сервери для обходу NAT в production
# Для тестування вистачить безкоштовних STUN серверів від Google
# NEXT_PUBLIC_TURN_URL="turn:your.turn.server:3478"
# NEXT_PUBLIC_TURN_USERNAME="username"
# NEXT_PUBLIC_TURN_CREDENTIAL="password"
